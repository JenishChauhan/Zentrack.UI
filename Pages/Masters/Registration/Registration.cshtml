@page
@model Zentrack.UI.Pages.Masters.Registration.RegistrationModel
@{
    ViewData["Title"] = "Registration Master";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/vendors/simple-datatables/style.css">
}

<div class="page-title">
    <div class="row">
        <div class="col-12 col-md-6 order-md-1 order-last">
            <h3>Registration Master</h3>
            <p class="text-subtitle text-muted">Manage business registrations and licenses.</p>
        </div>
        <div class="col-12 col-md-6 order-md-2 order-first">
            <div class="float-start float-lg-end mb-3">
                <button class="btn btn-primary" id="addNewBtn">
                    <i class="bi bi-plus"></i> Add New Registration
                </button>
            </div>
        </div>
    </div>
</div>

<section class="section">
    <div class="card">
        <div class="card-header">
            Registration List
        </div>
        <div class="card-body">
            <table class="table table-striped" id="table1">
                <thead>
                    <tr>
                        <th>Registration Name</th>
                        <th>Number</th>
                        <th>Expiry Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Trade License</td>
                        <td>TL-98765</td>
                        <td>2027-12-31</td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></button>
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/assets/vendors/simple-datatables/simple-datatables.js"></script>
    <script src="~/js/masters/registration.js"></script>
}
