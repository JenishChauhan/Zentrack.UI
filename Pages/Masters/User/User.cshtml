@page
@model Zentrack.UI.Pages.Masters.User.UserModel
@{
    ViewData["Title"] = "User Master";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/vendors/simple-datatables/style.css">
}

<div class="page-title">
    <div class="row">
        <div class="col-12 col-md-6 order-md-1 order-last">
            <h3>User Master</h3>
            <p class="text-subtitle text-muted">Manage system users and their profiles.</p>
        </div>
        <div class="col-12 col-md-6 order-md-2 order-first">
            <div class="float-start float-lg-end mb-3">
                <button class="btn btn-primary" id="addNewBtn">
                    <i class="bi bi-plus"></i> Add New User
                </button>
            </div>
        </div>
    </div>
</div>

<section class="section">
    <div class="card">
        <div class="card-header">
            User List
        </div>
        <div class="card-body">
            <table class="table table-striped" id="table1">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Admin</td>
                        <td>admin@zentrack.com</td>
                        <td>1234567890</td>
                        <td>Administrator</td>
                        <td><span class="badge bg-success">Active</span></td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></button>
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>
                    <tr>
                        <td>John Doe</td>
                        <td>john@example.com</td>
                        <td>9876543210</td>
                        <td>User</td>
                        <td><span class="badge bg-warning">Inactive</span></td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></button>
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/assets/vendors/simple-datatables/simple-datatables.js"></script>
    <script src="~/js/masters/user.js"></script>
}
